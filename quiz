<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>RPD Quiz</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea, #764ba2);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.quiz-container {
    width: 100%;
    max-width: 750px;
    background: white;
    border-radius: 20px;
    padding: 35px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
}

.header {
    text-align: center;
    margin-bottom: 25px;
}

.header h1 {
    color: #333;
    margin-bottom: 8px;
}

.header p {
    color: #777;
}

.progress {
    text-align: center;
    color: #666;
    margin-bottom: 15px;
    font-weight: bold;
}

.section {
    display: inline-block;
    background: #eef0ff;
    color: #667eea;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 13px;
    margin-bottom: 15px;
    font-weight: bold;
}

.question {
    font-size: 21px;
    font-weight: bold;
    color: #222;
    line-height: 1.5;
    margin-bottom: 22px;
}

.options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.option {
    border: 2px solid #ddd;
    border-radius: 12px;
    padding: 15px;
    cursor: pointer;
    background: white;
    transition: all 0.2s ease;
    font-size: 16px;
}

.option:hover {
    border-color: #667eea;
    background: #f5f6ff;
}

.option.selected {
    border-color: #667eea;
    background: #eef0ff;
}

.next-btn,
.restart-btn {
    width: 100%;
    border: none;
    padding: 15px;
    border-radius: 12px;
    margin-top: 25px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    background: #667eea;
    color: white;
    transition: 0.2s;
}

.next-btn:hover,
.restart-btn:hover {
    background: #5568d9;
}

.next-btn:disabled {
    background: #bbb;
    cursor: not-allowed;
}

.result {
    text-align: center;
    display: none;
}

.result h2 {
    font-size: 30px;
    color: #333;
    margin-bottom: 20px;
}

.score {
    font-size: 60px;
    font-weight: bold;
    color: #667eea;
    margin: 20px 0;
}

.percentage {
    font-size: 24px;
    color: #555;
    margin-bottom: 15px;
}

.message {
    font-size: 18px;
    color: #666;
}

@media (max-width: 600px) {

    .quiz-container {
        padding: 25px 18px;
    }

    .question {
        font-size: 18px;
    }

    .score {
        font-size: 48px;
    }
}
</style>
</head>

<body>

<div class="quiz-container">

    <!-- QUIZ -->

    <div id="quiz">

        <div class="header">
            <h1>RPD Quiz</h1>
            <p>Removable Partial Denture</p>
        </div>

        <div class="progress" id="progress"></div>

        <div class="section" id="section"></div>

        <div class="question" id="question"></div>

        <div class="options" id="options"></div>

        <button class="next-btn" id="nextBtn" disabled>
            Next Question
        </button>

    </div>


    <!-- RESULT -->

    <div class="result" id="result">

        <h2>Quiz Completed!</h2>

        <div class="score" id="score"></div>

        <div class="percentage" id="percentage"></div>

        <div class="message" id="message"></div>

        <button class="restart-btn" onclick="restartQuiz()">
            Restart Quiz
        </button>

    </div>

</div>


<script>

/* =========================================
   QUIZ QUESTIONS
========================================= */

const questions = [

    {
        section: "Section A: Terminology & Classification",

        question:
        "The quality of a prosthesis to resist vertical forces of dislodgement is known as:",

        options: [
            "Support",
            "Retention",
            "Stability",
            "Reciprocation"
        ],

        answer: 1
    },


    {
        section: "Section A: Terminology & Classification",

        question:
        "According to Kennedy Classification, which class involves bilateral edentulous areas located posterior to the remaining natural teeth?",

        options: [
            "Class I",
            "Class II",
            "Class III",
            "Class IV"
        ],

        answer: 0
    },


    {
        section: "Section A: Terminology & Classification",

        question:
        "A single edentulous area located anterior to remaining natural teeth and involving the midline is classified under Kennedy's system as:",

        options: [
            "Class I",
            "Class II",
            "Class III",
            "Class IV"
        ],

        answer: 3
    },


    {
        section: "Section A: Terminology & Classification",

        question:
        "Applegate's rule states that which molar is NOT considered in classification if it is missing and not to be replaced?",

        options: [
            "1st Molar",
            "2nd Molar",
            "3rd Molar",
            "Premolar"
        ],

        answer: 2
    },


    {
        section: "Section B: Components & Connectors",

        question:
        "The rigid part of a maxillary major connector that is broad, thin, and covers more than half of the hard palate is:",

        options: [
            "Single Palatal Strap",
            "Palatal Plate",
            "U-Shaped Connector",
            "Single Palatal Bar"
        ],

        answer: 1
    },


    {
        section: "Section B: Components & Connectors",

        question:
        "What is the minimum distance required between the free gingival margin and the maxillary major connector according to design considerations?",

        options: [
            "2 mm",
            "4 mm",
            "6 mm",
            "8 mm"
        ],

        answer: 2
    },


    {
        section: "Section B: Components & Connectors",

        question:
        "Which mandibular major connector is indicated when there is 0 mm vertical space between the gingival margin and the floor of the mouth?",

        options: [
            "Lingual Bar",
            "Linguoplate",
            "Sublingual Bar",
            "Labial Bar"
        ],

        answer: 1
    },


    {
        section: "Section B: Components & Connectors",

        question:
        "The component of a clasp assembly that is rigid, located above the height of contour, and provides stability is the:",

        options: [
            "Retentive arm",
            "Reciprocal arm",
            "Minor connector",
            "Rest"
        ],

        answer: 1
    },


    {
        section: "Section C: Surveying & Impression Techniques",

        question:
        "The instrument used to determine the relative parallelism of two or more surfaces of teeth or other parts of a dental arch is called a:",

        options: [
            "Facebow",
            "Articulator",
            "Dental Surveyor",
            "Caliper"
        ],

        answer: 2
    },


    {
        section: "Section C: Surveying & Impression Techniques",

        question:
        "The method used to record the exact position and orientation of a cast on a surveyor using three small points is known as:",

        options: [
            "Surveying",
            "Tripoding",
            "Blockout",
            "Beading"
        ],

        answer: 1
    },


    {
        section: "Section C: Surveying & Impression Techniques",

        question:
        "A cast-metal partial denture utilizing an impression material such as fluid waxes for the distal extension ridge is an example of:",

        options: [
            "Anatomic form impression",
            "Functional form impression",
            "Preliminary impression",
            "Mucostatic impression"
        ],

        answer: 1
    },


    {
        section: "Section C: Surveying & Impression Techniques",

        question:
        "What depth of undercut is typically engaged by a standard cast circumferential clasp?",

        options: [
            "0.01 inch",
            "0.02 inch",
            "0.03 inch",
            "0.05 inch"
        ],

        answer: 0
    }

];


/* =========================================
   VARIABLES
========================================= */

let currentQuestion = 0;
let score = 0;
let selectedAnswer = null;


/* =========================================
   ELEMENTS
========================================= */

const questionElement =
    document.getElementById("question");

const optionsElement =
    document.getElementById("options");

const progressElement =
    document.getElementById("progress");

const sectionElement =
    document.getElementById("section");

const nextButton =
    document.getElementById("nextBtn");

const quizElement =
    document.getElementById("quiz");

const resultElement =
    document.getElementById("result");

const scoreElement =
    document.getElementById("score");

const percentageElement =
    document.getElementById("percentage");

const messageElement =
    document.getElementById("message");


/* =========================================
   LOAD QUESTION
========================================= */

function loadQuestion() {

    selectedAnswer = null;

    nextButton.disabled = true;

    const current = questions[currentQuestion];

    progressElement.textContent =
        `Question ${currentQuestion + 1} of ${questions.length}`;

    sectionElement.textContent =
        current.section;

    questionElement.textContent =
        current.question;

    optionsElement.innerHTML = "";


    current.options.forEach((option, index) => {

        const optionElement =
            document.createElement("div");

        optionElement.classList.add("option");

        optionElement.textContent =
            `${String.fromCharCode(65 + index)}) ${option}`;


        optionElement.addEventListener("click", () => {

            document
                .querySelectorAll(".option")
                .forEach(item =>
                    item.classList.remove("selected")
                );


            optionElement.classList.add("selected");

            selectedAnswer = index;

            nextButton.disabled = false;

        });


        optionsElement.appendChild(optionElement);

    });


    if (currentQuestion === questions.length - 1) {

        nextButton.textContent = "Finish Quiz";

    } else {

        nextButton.textContent = "Next Question";

    }

}


/* =========================================
   NEXT / FINISH
========================================= */

nextButton.addEventListener("click", () => {

    /*
       Answer is checked internally.
       Correct/wrong result is NOT displayed.
    */

    if (
        selectedAnswer ===
        questions[currentQuestion].answer
    ) {

        score++;

    }


    currentQuestion++;


    if (currentQuestion < questions.length) {

        loadQuestion();

    } else {

        showResult();

    }

});


/* =========================================
   SHOW FINAL RESULT
========================================= */

function showResult() {

    quizElement.style.display = "none";

    resultElement.style.display = "block";


    const total = questions.length;

    const percentage =
        Math.round((score / total) * 100);


    scoreElement.textContent =
        `${score} / ${total}`;


    percentageElement.textContent =
        `${percentage}%`;


    if (percentage >= 80) {

        messageElement.textContent =
            "Excellent performance!";

    }

    else if (percentage >= 60) {

        messageElement.textContent =
            "Good work! Keep practicing.";

    }

    else {

        messageElement.textContent =
            "Keep practicing and try again.";

    }

}


/* =========================================
   RESTART
========================================= */

function restartQuiz() {

    currentQuestion = 0;

    score = 0;

    selectedAnswer = null;


    resultElement.style.display = "none";

    quizElement.style.display = "block";


    loadQuestion();

}


/* =========================================
   START
========================================= */

loadQuestion();

</script>

</body>
</html>